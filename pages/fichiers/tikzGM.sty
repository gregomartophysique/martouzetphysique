\tikzset {
	simplearrow/.style args={#1}{%
		postaction={decorate,decoration={markings, mark=at position #1 with {\arrow[scale=1.5,>=stealth]{>}}}}
	},
	simplearrow/.default=0.5,
	doublearrow/.style args={#1}{%
		postaction={decorate,decoration={markings, mark=at position #1 with {\arrow[scale=1.5,>=stealth]{>>}}}}
